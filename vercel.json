{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "{musanga/**,seed.py}" }
    },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/web/index.html" },
    { "src": "/track", "dest": "/web/track.html" },
    { "src": "/sign(/.*)?", "dest": "/web/sign.html" },
    { "src": "/(css|js|img)/(.*)", "dest": "/web/$1/$2" },
    { "src": "/favicon.ico", "dest": "/web/img/favicon.svg" },
    { "src": "/app(/.*)?", "dest": "/web/app.html" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ],
  "env": {
    "MUSANGA_ENV": "production",
    "MUSANGA_DB": "/tmp/musanga.db",
    "MUSANGA_SEED": "demo"
  }
}
